# 邮件服务（注册邮箱验证码，不配置则提示「邮件服务未启用」）
# 设为 true 并填写下方 SMTP 信息后，注册页才能发送邮箱验证码
EMAIL_ENABLED=true
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USERNAME=你的QQ邮箱@qq.com
EMAIL_PASSWORD=QQ邮箱授权码
EMAIL_FROM=你的QQ邮箱@qq.com
EMAIL_FROM_NAME=九柚米
