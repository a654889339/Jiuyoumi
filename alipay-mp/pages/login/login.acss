.page-login {
  min-height: 100vh;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.login-header {
  padding: 120rpx 0 80rpx;
  text-align: center;
}

.brand-name {
  font-size: 64rpx;
  font-weight: 800;
  color: #667eea;
  display: block;
}

.brand-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}

.login-form {
  margin-bottom: 48rpx;
}

.input-group {
  display: flex;
  align-items: center;
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 4rpx 24rpx;
  margin-bottom: 24rpx;
}

.input-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.form-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
}

.btn-login {
  width: 100%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 16rpx;
  letter-spacing: 4rpx;
}

.btn-login[disabled] {
  opacity: 0.6;
}

.register-link {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #999;
}

.link-text {
  color: #667eea;
  margin-left: 8rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin: 48rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #eee;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #999;
}

.btn-alipay-login {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #1677ff;
  color: #fff;
  border: none;
  border-radius: 44rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-alipay-login[disabled] {
  opacity: 0.6;
}

.alipay-icon {
  font-size: 36rpx;
}
