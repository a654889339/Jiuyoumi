<view class="page-index">
  <!-- Banner -->
  <view class="hero-wrapper">
    <view class="banner">
      <swiper a:if="{{banners.length}}" class="banner-swipe" autoplay circular indicator-dots indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#fff">
        <swiper-item a:for="{{banners}}" a:key="id">
          <image a:if="{{item.imageUrl}}" src="{{item.imageUrl}}" class="banner-img" mode="aspectFill" />
          <view a:else class="banner-text" style="background: {{item.color || 'linear-gradient(135deg, #667eea, #764ba2)'}};">
            <text class="banner-title">{{item.title}}</text>
            <text class="banner-desc">{{item.desc}}</text>
          </view>
        </swiper-item>
      </swiper>
      <view a:else class="banner-content">
        <text class="brand-name">九尤米</text>
        <text class="brand-sub">品质生活 · 精选好物</text>
      </view>
    </view>

    <!-- 快捷导航 (浮动在轮播图上) -->
    <view class="nav-float card">
      <view class="nav-item" a:for="{{navItems}}" a:key="title" onTap="onNavTap" data-path="{{item.path}}">
        <view class="nav-icon" style="background: {{item.imageUrl ? 'transparent' : item.color}};">
          <image a:if="{{item.imageUrl}}" src="{{item.imageUrl}}" class="nav-icon-img" mode="aspectFill" />
          <text a:else class="nav-emoji">{{item.icon}}</text>
        </view>
        <text class="nav-text">{{item.title}}</text>
      </view>
    </view>
  </view>

  <!-- 热门商品 -->
  <view class="section hot-section">
    <view class="section-header">
      <text class="section-title">热门商品</text>
      <text class="section-more" onTap="goProducts">查看全部 ›</text>
    </view>
    <scroll-view class="hot-scroll" scroll-x="{{true}}">
      <view class="hot-list">
        <view class="hot-card" a:for="{{hotProducts}}" a:key="id" onTap="goDetail" data-id="{{item.id}}">
          <image class="hot-img" src="{{item.coverImage || item.imageUrl || item.image}}" mode="aspectFill" />
          <view class="hot-info">
            <text class="hot-name">{{item.name}}</text>
            <text class="price">¥{{item.price}}</text>
          </view>
        </view>
        <view class="hot-card hot-card-placeholder" a:if="{{hotProducts.length === 0 && !loading}}">
          <text class="empty-tip">暂无商品</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
