.page-index {
  padding-bottom: 120rpx;
  background: #f5f5f5;
}

.hero-wrapper {
  position: relative;
}

.banner {
  height: 560rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  overflow: hidden;
}

.banner-swipe {
  width: 100%;
  height: 560rpx;
}

.banner-img {
  width: 100%;
  height: 560rpx;
}

.banner-text {
  width: 100%;
  height: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.banner-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
}

.banner-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

.banner-content {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.brand-name {
  font-size: 60rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 8rpx;
}

.brand-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}

.nav-float {
  position: absolute;
  bottom: -60rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 10;
  display: flex;
  justify-content: space-around;
  padding: 32rpx 16rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  overflow: hidden;
}

.nav-icon-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
}

.nav-emoji {
  font-size: 44rpx;
}

.nav-text {
  font-size: 24rpx;
  color: #666;
}

.section {
  padding: 24rpx;
}

.hot-section {
  margin-top: 80rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #667eea;
}

.hot-scroll {
  white-space: nowrap;
  margin: 0 -24rpx;
  padding: 0 24rpx;
}

.hot-list {
  display: inline-flex;
  gap: 20rpx;
  padding-bottom: 16rpx;
}

.hot-card {
  width: 280rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  display: inline-block;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.hot-img {
  width: 280rpx;
  height: 280rpx;
}

.hot-info {
  padding: 16rpx 20rpx;
}

.hot-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price {
  font-size: 28rpx;
  font-weight: 700;
  color: #f5576c;
}

.hot-card-placeholder {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 360rpx;
}

.empty-tip {
  color: #999;
  font-size: 26rpx;
}
