.page-address {
  padding: 24rpx;
  padding-bottom: 160rpx;
  min-height: 100vh;
}

.address-card {
  margin-bottom: 20rpx;
}

.addr-main {
  margin-bottom: 16rpx;
}

.addr-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.addr-phone {
  font-size: 28rpx;
  color: #666;
}

.addr-default {
  font-size: 20rpx;
  color: #667eea;
  border: 1rpx solid #667eea;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.addr-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.addr-actions {
  display: flex;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.addr-action {
  font-size: 26rpx;
  color: #667eea;
}

.addr-delete {
  color: #f5576c;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}

.add-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btn-add {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}
