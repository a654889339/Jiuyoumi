<view class="page-mine">
  <!-- 头部信息 -->
  <view class="profile-header">
    <view class="profile-card" a:if="{{isLogin && userInfo}}">
      <image class="avatar" src="{{userInfo.avatar || '/assets/default-avatar.png'}}" mode="aspectFill" />
      <view class="profile-info">
        <text class="nickname">{{userInfo.nickname || userInfo.username || '用户'}}</text>
        <text class="phone" a:if="{{userInfo.phone}}">{{userInfo.phone}}</text>
      </view>
      <view class="edit-btn" onTap="goEditProfile">
        <text class="edit-text">编辑 ›</text>
      </view>
    </view>
    <view class="profile-card login-card" a:else onTap="goLogin">
      <view class="avatar avatar-default">
        <text class="avatar-icon">👤</text>
      </view>
      <view class="profile-info">
        <text class="nickname">点击登录</text>
        <text class="phone">登录享更多权益</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 统计栏 -->
  <view class="stats-bar card" a:if="{{isLogin}}">
    <view class="stat-item" onTap="goOrders" data-status="pending">
      <text class="stat-num">{{stats.pending}}</text>
      <text class="stat-label">待支付</text>
    </view>
    <view class="stat-item" onTap="goOrders" data-status="shipped">
      <text class="stat-num">{{stats.shipped}}</text>
      <text class="stat-label">已发货</text>
    </view>
    <view class="stat-item" onTap="goOrders" data-status="review">
      <text class="stat-icon">⭐</text>
      <text class="stat-label">待评价</text>
    </view>
    <view class="stat-item" onTap="goOrders" data-status="aftersale">
      <text class="stat-icon">🔧</text>
      <text class="stat-label">售后</text>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu-list card">
    <view class="menu-item" onTap="goOrders">
      <text class="menu-icon">📋</text>
      <text class="menu-text">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" onTap="goCart">
      <text class="menu-icon">🛒</text>
      <text class="menu-text">购物车</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" onTap="goAddress">
      <text class="menu-icon">📍</text>
      <text class="menu-text">地址管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" onTap="goChat">
      <text class="menu-icon">💬</text>
      <text class="menu-text">在线客服</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-wrap" a:if="{{isLogin}}">
    <button class="btn-logout" onTap="logout">退出登录</button>
  </view>
</view>
