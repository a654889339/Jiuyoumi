<view class="page-order-detail" a:if="{{order}}">
  <!-- 订单状态栏 -->
  <view class="status-bar status-bg-{{order.status}}">
    <text class="status-text">{{statusMap[order.status] || order.status}}</text>
    <text class="status-desc" a:if="{{order.status === 'pending'}}">请尽快完成支付</text>
    <text class="status-desc" a:if="{{order.status === 'shipped'}}">商品正在配送中</text>
    <text class="status-desc" a:if="{{order.status === 'completed'}}">订单已完成</text>
  </view>

  <!-- 物流信息 -->
  <view class="card tracking-card" a:if="{{order.trackingNo}}">
    <view class="card-title-row">
      <text class="card-title">物流信息</text>
      <text class="tracking-no">物流单号: {{order.trackingNo}}</text>
    </view>
    <view class="tracking-steps" a:if="{{tracking && tracking.steps && tracking.steps.length > 0}}">
      <view class="step {{index === 0 ? 'step-active' : ''}}" a:for="{{tracking.steps}}" a:key="index">
        <view class="step-dot-wrap">
          <view class="step-dot"></view>
          <view class="step-line" a:if="{{index < tracking.steps.length - 1}}"></view>
        </view>
        <view class="step-content">
          <text class="step-text">{{item.content || item.desc}}</text>
          <text class="step-time">{{item.time}}</text>
        </view>
      </view>
    </view>
    <view a:else class="tracking-empty">
      <text>暂无物流信息</text>
    </view>
  </view>

  <!-- 收货地址 -->
  <view class="card" a:if="{{order.contactName || order.address}}">
    <text class="card-title">收货地址</text>
    <view class="address-info">
      <view class="address-row">
        <text class="address-name">{{order.contactName}}</text>
        <text class="address-phone">{{order.contactPhone}}</text>
      </view>
      <text class="address-text">{{order.address}}</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="card">
    <text class="card-title">商品信息</text>
    <view class="order-item" a:for="{{order.items}}" a:key="id">
      <image class="item-img" src="{{item.imageUrl || item.image}}" mode="aspectFill" />
      <view class="item-info">
        <text class="item-name">{{item.name || item.productName}}</text>
        <view class="item-row">
          <text class="price">¥{{item.price}}</text>
          <text class="item-qty">x{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="card">
    <text class="card-title">订单信息</text>
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <view class="info-value-wrap">
        <text class="info-value">{{order.orderNo || order.id}}</text>
        <text class="copy-btn" onTap="copyOrderNo">复制</text>
      </view>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{order.createdAt || order.createTime}}</text>
    </view>
    <view class="info-row" a:if="{{order.remark}}">
      <text class="info-label">备注</text>
      <text class="info-value">{{order.remark}}</text>
    </view>
    <view class="info-row total-row">
      <text class="info-label">订单金额</text>
      <text class="price total-price">¥{{order.totalAmount}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions" a:if="{{order.status === 'pending'}}">
    <button class="btn-cancel" onTap="cancelOrder">取消订单</button>
  </view>
</view>

<view class="loading-page" a:if="{{loading}}">
  <text>加载中...</text>
</view>
