<view class="page-orders">
  <!-- Tab -->
  <view class="tabs">
    <view
      class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}"
      a:for="{{tabs}}"
      a:key="key"
      onTap="switchTab"
      data-key="{{item.key}}"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" a:if="{{orders.length > 0}}">
    <view class="order-card card" a:for="{{orders}}" a:key="id" onTap="goDetail" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-no">订单号: {{item.orderNo || item.id}}</text>
        <text class="order-status status-{{item.status}}">{{statusMap[item.status] || item.status}}</text>
      </view>

      <view class="order-items">
        <view class="order-item" a:for="{{item.items}}" a:for-item="product" a:key="id">
          <image class="item-img" src="{{product.imageUrl || product.image}}" mode="aspectFill" />
          <view class="item-info">
            <text class="item-name">{{product.name || product.productName}}</text>
            <view class="item-row">
              <text class="price">¥{{product.price}}</text>
              <text class="item-qty">x{{product.quantity}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="order-footer">
        <text class="order-total">合计: <text class="price">¥{{item.totalPrice || item.totalAmount}}</text></text>
        <view class="order-actions" catchTap="">
          <button class="btn-sm btn-outline" a:if="{{item.trackingNo}}" catchTap="viewTracking" data-id="{{item.id}}">查看物流</button>
          <button class="btn-sm btn-danger-outline" a:if="{{item.status === 'pending'}}" catchTap="cancelOrder" data-id="{{item.id}}">取消订单</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="loading-more" a:if="{{loadingMore}}">
    <text>加载更多...</text>
  </view>
  <view class="no-more" a:if="{{finished && orders.length > 0}}">
    <text>没有更多订单了</text>
  </view>

  <view class="empty" a:if="{{!loading && orders.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
  </view>
</view>
