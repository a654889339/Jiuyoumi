.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f8f8f8;
}

.chat-body {
  flex: 1;
  padding: 16rpx;
}

.chat-empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 120rpx 40rpx;
}

.chat-msg {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.msg-right {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.avatar-admin {
  background: #667eea;
  color: #fff;
}

.avatar-user {
  background: #e5e7eb;
  color: #6b7280;
}

.bubble-wrap {
  max-width: 75%;
  margin: 0 16rpx;
}

.bubble-text {
  display: block;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}

.msg-left .bubble-text {
  background: #fff;
  color: #333;
  border: 1px solid #eee;
  border-top-left-radius: 8rpx;
}

.msg-right .bubble-text {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-top-right-radius: 8rpx;
}

.bubble-img {
  max-width: 400rpx;
  border-radius: 16rpx;
  display: block;
}

.bubble-time {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.msg-right .bubble-time {
  text-align: right;
}

.chat-footer {
  padding: 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.send-btn {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.send-btn[disabled] {
  opacity: 0.5;
}

.login-hint {
  text-align: center;
  font-size: 26rpx;
  color: #667eea;
  padding: 16rpx;
  text-decoration: underline;
}
