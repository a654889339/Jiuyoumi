.page-cart {
  padding-bottom: 160rpx;
  min-height: 100vh;
}

.cart-list {
  padding: 24rpx;
}

.cart-item-wrap {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
}

.cart-item {
  display: flex;
  background: #fff;
  padding: 24rpx;
  border-radius: 20rpx;
  transition: transform 0.3s;
  position: relative;
  z-index: 2;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.slide-open .cart-item {
  transform: translateX(-140rpx);
}

.delete-btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  background: #f5576c;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  border-radius: 0 20rpx 20rpx 0;
  z-index: 1;
}

.cart-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.cart-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cart-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.cart-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.qty-stepper {
  display: flex;
  align-items: center;
  background: #f5f5f7;
  border-radius: 24rpx;
  overflow: hidden;
}

.qty-btn {
  width: 56rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
}

.qty-num {
  width: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 30rpx;
  margin-bottom: 32rpx;
}

.empty-link {
  color: #667eea;
  font-size: 28rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 999;
}

.total-info {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 40rpx;
}

.btn-checkout {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}
