<view class="page-detail" a:if="{{product}}">
  <!-- 商品图片轮播 -->
  <view class="swiper-wrap">
    <swiper class="product-swiper" indicator-dots="{{false}}" autoplay circular onChange="onSwiperChange">
      <swiper-item a:for="{{product.images}}" a:key="*this">
        <image class="swiper-img" src="{{item}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
    <view class="swiper-dots">
      <view
        class="dot {{currentSwiper === index ? 'dot-active' : ''}}"
        a:for="{{product.images}}"
        a:key="*this"
      ></view>
    </view>
  </view>

  <!-- 价格信息 -->
  <view class="info-card">
    <view class="price-row">
      <text class="detail-price">¥{{product.price}}</text>
      <text class="detail-original" a:if="{{product.originalPrice}}">¥{{product.originalPrice}}</text>
      <text class="detail-sales" a:if="{{product.sales}}">已售{{product.sales}}件</text>
    </view>
    <text class="detail-name">{{product.name}}</text>
    <text class="detail-desc" a:if="{{product.description}}">{{product.description}}</text>
  </view>

  <!-- 商品详情 -->
  <view class="desc-card" a:if="{{product.detail}}">
    <text class="section-title">商品详情</text>
    <rich-text nodes="{{product.detail}}"></rich-text>
  </view>

  <!-- 底部安全区占位 -->
  <view class="bottom-placeholder"></view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bar-icon" onTap="goCart">
      <text class="bar-icon-emoji">🛒</text>
      <text class="bar-icon-text">购物车</text>
    </view>
    <view class="bar-icon" onTap="goConsult">
      <text class="bar-icon-emoji">💬</text>
      <text class="bar-icon-text">咨询</text>
    </view>
    <view class="bar-btns">
      <button class="btn-add-cart" onTap="addToCart">加入购物车</button>
      <button class="btn-buy-now" onTap="buyNow">立即购买</button>
    </view>
  </view>
</view>

<view class="loading-page" a:if="{{loading}}">
  <text>加载中...</text>
</view>
