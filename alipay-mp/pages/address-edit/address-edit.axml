<view class="page-address-edit">
  <view class="form-card card">
    <view class="form-item">
      <text class="form-label">联系人</text>
      <input class="form-input" placeholder="请输入联系人姓名" value="{{contactName}}" onInput="onNameInput" />
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{contactPhone}}" onInput="onPhoneInput" />
    </view>

    <view class="form-item">
      <text class="form-label">省市区</text>
      <picker mode="region" value="{{region}}" onChange="onRegionChange">
        <view class="picker-value {{province ? '' : 'placeholder'}}">
          {{province ? province + ' ' + city + ' ' + district : '请选择省市区'}}
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">详细地址</text>
      <textarea class="form-textarea" placeholder="街道、楼栋、门牌号等" value="{{detail}}" onInput="onDetailInput" maxlength="200" auto-height="{{true}}" />
    </view>

    <view class="form-item switch-item">
      <text class="form-label">默认地址</text>
      <switch checked="{{isDefault}}" onChange="onDefaultChange" color="#667eea" />
    </view>
  </view>

  <view class="save-wrap">
    <button class="btn-save" onTap="save" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存'}}
    </button>
  </view>
</view>
