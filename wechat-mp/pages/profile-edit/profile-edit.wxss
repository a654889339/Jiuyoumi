.page-profile-edit {
  padding: 24rpx;
  min-height: 100vh;
}

.form-card {
  padding: 16rpx 32rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  font-size: 30rpx;
  color: #333;
  height: 56rpx;
}

.save-wrap {
  padding: 48rpx 0;
}

.btn-save {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-save[disabled] {
  opacity: 0.6;
}
