<view class="page-checkout">
  <!-- 收货地址 -->
  <view class="address-card card" bindtap="chooseAddress">
    <view class="address-content" wx:if="{{address}}">
      <view class="address-row">
        <text class="address-name">{{address.contactName || address.name}}</text>
        <text class="address-phone">{{address.contactPhone || address.phone}}</text>
      </view>
      <text class="address-detail">{{address.fullAddress || address.province}}{{address.city}}{{address.district}}{{address.detail || address.address}}</text>
    </view>
    <view class="address-empty" wx:else>
      <text class="address-add">+ 选择收货地址</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 商品列表 -->
  <view class="card">
    <text class="card-title">商品信息</text>
    <view class="checkout-item" wx:for="{{items}}" wx:key="productId">
      <image class="item-img" src="{{item.imageUrl || item.image || item.product.imageUrl}}" mode="aspectFill" />
      <view class="item-info">
        <text class="item-name">{{item.name || item.productName || item.product.name}}</text>
        <view class="item-row">
          <text class="price">¥{{item.price}}</text>
          <text class="item-qty">x{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="card remark-card">
    <text class="card-title">备注</text>
    <textarea class="remark-input" placeholder="备注信息（选填）" value="{{remark}}" bindinput="onRemarkInput" maxlength="200" auto-height />
  </view>

  <view class="bottom-placeholder"></view>

  <!-- 底部结算栏 -->
  <view class="bottom-bar">
    <view class="total-info">
      <text class="total-label">合计:</text>
      <text class="price total-price">¥{{totalAmount}}</text>
    </view>
    <button class="btn-submit" bindtap="submitOrder" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交订单'}}
    </button>
  </view>
</view>
