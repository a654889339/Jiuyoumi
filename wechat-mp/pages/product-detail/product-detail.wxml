<view class="page-detail" wx:if="{{product}}">
  <view class="swiper-wrap">
    <swiper class="product-swiper" indicator-dots="{{false}}" autoplay circular bindchange="onSwiperChange">
      <swiper-item wx:for="{{mediaList}}" wx:key="index">
        <view wx:if="{{item.type === 'video'}}" class="media-item" bindtap="playVideo" data-url="{{item.url}}">
          <image class="swiper-img" src="{{item.cover}}" mode="aspectFill" />
          <view class="play-overlay">
            <text class="play-icon">▶</text>
          </view>
        </view>
        <image wx:else class="swiper-img" src="{{item.url}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}" />
      </swiper-item>
    </swiper>
    <view class="swipe-indicator">{{currentSwiper + 1}} / {{mediaList.length}}</view>
  </view>

  <view class="info-card">
    <view class="price-row">
      <text class="detail-price">¥{{product.price}}</text>
      <text class="detail-original" wx:if="{{product.originalPrice}}">¥{{product.originalPrice}}</text>
      <text class="detail-sales" wx:if="{{product.sales}}">已售{{product.sales}}件</text>
    </view>
    <text class="detail-name">{{product.name}}</text>
    <text class="detail-desc" wx:if="{{product.description}}">{{product.description}}</text>
    <view class="fav-row">
      <view class="fav-btn {{product.isFavorited ? 'active' : ''}}" bindtap="toggleFav">
        <text class="fav-btn-icon">{{product.isFavorited ? '❤️' : '🤍'}}</text>
        <text class="fav-btn-text">{{product.isFavorited ? '已关注' : '关注'}}</text>
      </view>
      <text class="fav-count">{{product.favCount || 0}} 人关注</text>
    </view>
  </view>

  <view class="desc-card" wx:if="{{product.detail}}">
    <text class="section-title">商品详情</text>
    <rich-text nodes="{{product.detail}}"></rich-text>
  </view>

  <view class="bottom-placeholder"></view>

  <view class="bottom-bar">
    <view class="bar-icon bar-icon-cart" bindtap="goCart">
      <text class="bar-icon-emoji">🛒</text>
    </view>
    <view class="bar-icon" bindtap="goConsult">
      <text class="bar-icon-emoji">💬</text>
      <text class="bar-icon-text">咨询</text>
    </view>
    <view class="bar-btns">
      <button class="btn-add-cart" bindtap="addToCart">加入购物车</button>
      <button class="btn-buy-now" bindtap="buyNow">立即下单</button>
    </view>
  </view>
</view>

<view class="loading-page" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
