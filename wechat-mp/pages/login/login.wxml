<view class="page-login">
  <view class="login-header">
    <text class="brand-name">九柚米</text>
    <text class="brand-sub">品质生活 · 精选好物</text>
  </view>

  <view class="login-form">
    <view class="input-group">
      <text class="input-icon">👤</text>
      <input class="form-input" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view class="input-group">
      <text class="input-icon">🔒</text>
      <input class="form-input" placeholder="请输入密码" password="true" value="{{password}}" bindinput="onPasswordInput" />
    </view>

    <button class="btn-login" bindtap="login" disabled="{{logging}}">
      {{logging ? '登录中...' : '登录'}}
    </button>

    <view class="register-link" bindtap="goRegister">
      <text>还没有账号？</text>
      <text class="link-text">立即注册</text>
    </view>
  </view>

  <view class="divider">
    <view class="divider-line"></view>
    <text class="divider-text">其他登录方式</text>
    <view class="divider-line"></view>
  </view>

  <button class="btn-wx-login" bindtap="wxLogin" disabled="{{logging}}">
    <text class="wx-icon">💬</text>
    <text>微信一键登录</text>
  </button>
</view>
