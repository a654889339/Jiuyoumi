.page-login {
  min-height: 100vh;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.login-header {
  padding: 120rpx 0 80rpx;
  text-align: center;
}

.brand-name {
  font-size: 64rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #667eea, #764ba2);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: block;
}

.brand-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}

.login-form {
  margin-bottom: 48rpx;
}

.input-group {
  display: flex;
  align-items: center;
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 4rpx 24rpx;
  margin-bottom: 24rpx;
}

.input-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.form-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
}

.btn-login {
  width: 100%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 16rpx;
  letter-spacing: 4rpx;
}

.btn-login[disabled] {
  opacity: 0.6;
}

.register-link {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #999;
}

.link-text {
  color: #667eea;
  margin-left: 8rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin: 48rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #eee;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #999;
}

.btn-wx-login {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 44rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-wx-login[disabled] {
  opacity: 0.6;
}

.wx-icon {
  font-size: 36rpx;
}

.tabs {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
  border-bottom: 1rpx solid #eee;
}
.tab {
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  color: #999;
  position: relative;
}
.tab-active {
  color: #667eea;
  font-weight: 600;
}
.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #667eea;
  border-radius: 2rpx;
}
.code-group {
  position: relative;
}
.code-input {
  flex: 1;
  padding-right: 200rpx;
}
.btn-send-code {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #667eea;
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  border: none;
  line-height: 1.4;
}
.btn-send-code[disabled] {
  background: #ccc;
  color: #fff;
}
