<wxs module="utils">
  module.exports = {
    statusText: function(status) {
      var map = { pending: '待支付', paid: '已支付', shipped: '已发货', completed: '已完成', cancelled: '已取消' };
      return map[status] || status;
    },
    statusBg: function(status) {
      var map = { pending: 'status-bg-pending', paid: 'status-bg-paid', shipped: 'status-bg-shipped', completed: 'status-bg-completed', cancelled: 'status-bg-cancelled' };
      return map[status] || '';
    },
    formatTime: function(ts) {
      if (!ts) return '';
      var d = getDate(ts);
      var y = d.getFullYear();
      var m = d.getMonth() + 1;
      var day = d.getDate();
      var h = d.getHours();
      var min = d.getMinutes();
      return y + '-' + (m < 10 ? '0' + m : m) + '-' + (day < 10 ? '0' + day : day) + ' ' + (h < 10 ? '0' + h : h) + ':' + (min < 10 ? '0' + min : min);
    }
  };
</wxs>

<view class="page-order-detail" wx:if="{{order}}">
  <!-- 订单状态栏 -->
  <view class="status-bar {{utils.statusBg(order.status)}}">
    <text class="status-text">{{utils.statusText(order.status)}}</text>
    <text class="status-desc" wx:if="{{order.status === 'pending'}}">请尽快完成支付</text>
    <text class="status-desc" wx:if="{{order.status === 'shipped'}}">商品正在配送中</text>
    <text class="status-desc" wx:if="{{order.status === 'completed'}}">订单已完成</text>
  </view>

  <!-- 物流信息 -->
  <view class="card tracking-card" wx:if="{{order.trackingNo}}">
    <view class="card-title-row">
      <text class="card-title">物流信息</text>
      <text class="tracking-no">物流单号: {{order.trackingNo}}</text>
    </view>
    <view class="tracking-steps" wx:if="{{tracking && tracking.steps && tracking.steps.length > 0}}">
      <view class="step {{index === 0 ? 'step-active' : ''}}" wx:for="{{tracking.steps}}" wx:key="index">
        <view class="step-dot-wrap">
          <view class="step-dot"></view>
          <view class="step-line" wx:if="{{index < tracking.steps.length - 1}}"></view>
        </view>
        <view class="step-content">
          <text class="step-text">{{item.content || item.desc}}</text>
          <text class="step-time">{{item.time}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="tracking-empty">
      <text>暂无物流信息</text>
    </view>
  </view>

  <!-- 收货地址 -->
  <view class="card" wx:if="{{order.contactName || order.address}}">
    <text class="card-title">收货地址</text>
    <view class="address-info">
      <view class="address-row">
        <text class="address-name">{{order.contactName}}</text>
        <text class="address-phone">{{order.contactPhone}}</text>
      </view>
      <text class="address-text">{{order.address}}</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="card">
    <text class="card-title">商品信息</text>
    <view class="order-item" wx:for="{{order.items}}" wx:key="id">
      <image class="item-img" src="{{item.imageUrl || item.image}}" mode="aspectFill" />
      <view class="item-info">
        <text class="item-name">{{item.name || item.productName}}</text>
        <view class="item-row">
          <text class="price">¥{{item.price}}</text>
          <text class="item-qty">x{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="card">
    <text class="card-title">订单信息</text>
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <view class="info-value-wrap">
        <text class="info-value">{{order.orderNo || order.id}}</text>
        <text class="copy-btn" bindtap="copyOrderNo">复制</text>
      </view>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{utils.formatTime(order.createdAt || order.createTime)}}</text>
    </view>
    <view class="info-row" wx:if="{{order.remark}}">
      <text class="info-label">备注</text>
      <text class="info-value">{{order.remark}}</text>
    </view>
    <view class="info-row total-row">
      <text class="info-label">订单金额</text>
      <text class="price total-price">¥{{order.totalAmount}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions" wx:if="{{order.status === 'pending'}}">
    <button class="btn-cancel" bindtap="cancelOrder">取消订单</button>
  </view>
</view>

<view class="loading-page" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
