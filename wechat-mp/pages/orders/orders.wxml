<wxs module="utils">
  module.exports = {
    statusText: function(status) {
      var map = { pending: '待支付', paid: '已支付', shipped: '已发货', completed: '已完成', cancelled: '已取消' };
      return map[status] || status;
    },
    statusClass: function(status) {
      var map = { pending: 'status-pending', paid: 'status-paid', shipped: 'status-shipped', completed: 'status-completed', cancelled: 'status-cancelled' };
      return map[status] || '';
    }
  };
</wxs>

<view class="page-orders">
  <!-- Tab -->
  <view class="tabs">
    <view
      class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      bindtap="switchTab"
      data-key="{{item.key}}"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-card card" wx:for="{{orders}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-no">订单号: {{item.orderNo || item.id}}</text>
        <text class="order-status {{utils.statusClass(item.status)}}">{{utils.statusText(item.status)}}</text>
      </view>

      <view class="order-items">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="product" wx:key="id">
          <image class="item-img" src="{{product.imageUrl || product.image}}" mode="aspectFill" />
          <view class="item-info">
            <text class="item-name">{{product.name || product.productName}}</text>
            <view class="item-row">
              <text class="price">¥{{product.price}}</text>
              <text class="item-qty">x{{product.quantity}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="order-footer">
        <text class="order-total">合计: <text class="price">¥{{item.totalPrice || item.totalAmount}}</text></text>
        <view class="order-actions" catchtap="">
          <button class="btn-sm btn-outline" wx:if="{{item.trackingNo}}" catchtap="viewTracking" data-id="{{item.id}}">查看物流</button>
          <button class="btn-sm btn-danger-outline" wx:if="{{item.status === 'pending'}}" catchtap="cancelOrder" data-id="{{item.id}}">取消订单</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="loading-more" wx:if="{{loadingMore}}">
    <text>加载更多...</text>
  </view>
  <view class="no-more" wx:if="{{finished && orders.length > 0}}">
    <text>没有更多订单了</text>
  </view>

  <view class="empty" wx:if="{{!loading && orders.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
  </view>
</view>
