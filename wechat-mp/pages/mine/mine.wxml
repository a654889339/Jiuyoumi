<wxs module="utils">
  module.exports = {
    maskPhone: function(phone) {
      if (!phone || phone.length < 7) return phone || '';
      return phone.substring(0, 3) + '****' + phone.substring(7);
    }
  };
</wxs>

<view class="page-mine">
  <!-- 头部信息 -->
  <view class="profile-header">
    <view class="profile-card" wx:if="{{isLogin && userInfo}}">
      <image class="avatar" src="{{userInfo.avatar || '/assets/default-avatar.png'}}" mode="aspectFill" />
      <view class="profile-info">
        <text class="nickname">{{userInfo.nickname || userInfo.username || '用户'}}</text>
        <text class="phone" wx:if="{{userInfo.phone}}">{{utils.maskPhone(userInfo.phone)}}</text>
      </view>
      <view class="edit-btn" bindtap="goEditProfile">
        <text class="edit-text">编辑 ›</text>
      </view>
    </view>
    <view class="profile-card login-card" wx:else bindtap="goLogin">
      <view class="avatar avatar-default">
        <text class="avatar-icon">👤</text>
      </view>
      <view class="profile-info">
        <text class="nickname">点击登录</text>
        <text class="phone">登录享更多权益</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 统计栏 -->
  <view class="stats-bar card" wx:if="{{isLogin}}">
    <view class="stat-item" bindtap="goOrders" data-status="pending">
      <text class="stat-icon">💰</text>
      <text class="stat-label">待支付</text>
    </view>
    <view class="stat-item" bindtap="goOrders" data-status="shipped">
      <text class="stat-icon">🚚</text>
      <text class="stat-label">已发货</text>
    </view>
    <view class="stat-item" bindtap="goOrders" data-status="review">
      <text class="stat-icon">⭐</text>
      <text class="stat-label">待评价</text>
    </view>
    <view class="stat-item" bindtap="goOrders" data-status="aftersale">
      <text class="stat-icon">🔧</text>
      <text class="stat-label">售后</text>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu-list card">
    <view class="menu-item" bindtap="goOrders">
      <text class="menu-icon">📋</text>
      <text class="menu-text">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goCart">
      <text class="menu-icon">🛒</text>
      <text class="menu-text">购物车</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAddress">
      <text class="menu-icon">📍</text>
      <text class="menu-text">地址管理</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-wrap" wx:if="{{isLogin}}">
    <button class="btn-logout" bindtap="logout">退出登录</button>
  </view>
</view>
