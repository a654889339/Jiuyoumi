.page-register {
  min-height: 100vh;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  background: #fff;
}
.register-header {
  padding: 80rpx 0 48rpx;
  text-align: center;
}
.brand-name {
  font-size: 56rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #667eea, #764ba2);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: block;
}
.brand-sub {
  font-size: 32rpx;
  color: #333;
  margin-top: 8rpx;
  display: block;
  font-weight: 600;
}
.register-form {
  margin-bottom: 48rpx;
}
.input-group {
  display: flex;
  align-items: center;
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 4rpx 24rpx;
  margin-bottom: 24rpx;
  position: relative;
}
.input-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}
.form-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
}
.email-input, .phone-input {
  padding-right: 200rpx;
}
.btn-send-code {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #667eea;
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  border: none;
  line-height: 1.4;
}
.btn-send-code[disabled] {
  background: #ccc;
  color: #fff;
}
.btn-register {
  width: 100%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 16rpx;
  letter-spacing: 4rpx;
}
.btn-register[disabled] {
  opacity: 0.6;
}
.login-link {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #999;
}
.link-text {
  color: #667eea;
  margin-left: 8rpx;
}
